// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users (Google OAuth)
model User {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  googleId    String   @unique
  email       String   @unique
  name        String
  photo       String?
  role        UserRole @default(USER)

  submittedMovies       Movie[]        @relation("SubmittedMovies")
  submittedPhysicalCopies PhysicalCopy[] @relation("SubmittedPhysicalCopies")
  submittedBoxSets      BoxSet[]       @relation("SubmittedBoxSets")
  uploadedImages        MediaImage[]   @relation("UploadedImages")

  @@index([email])
  @@index([googleId])
}

// Movie is the core entity
model Movie {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Submission tracking
  status        EntryStatus @default(PENDING)
  submittedById String?
  submittedBy   User?    @relation("SubmittedMovies", fields: [submittedById], references: [id])
  verifiedAt    DateTime?
  rejectedAt    DateTime?
  rejectionReason String? @db.Text

  // Basic info
  title       String
  originalTitle String?
  year        Int?
  runtime     Int?      // in minutes

  // Content details
  plot        String?   @db.Text
  tagline     String?
  language    String?   // Primary language
  country     String?   // Country of origin

  // Media details
  posterUrl   String?
  backdropUrl String?

  // Source tracking
  sourceType  SourceType @default(MANUAL)

  // Physical media details (for manual entries)
  physicalFormat String? // DVD, Blu-ray, VHS, CD, Vinyl, etc.
  distributor    String?
  upc            String? // Universal Product Code / Barcode
  isbn           String? // For books (future expansion)
  asin           String? // Amazon Standard Identification Number
  notes          String? @db.Text

  // Media type classification
  mediaType      MediaType @default(MOVIE)

  // Ratings
  rating      Float?    // User/CMDB rating

  // Relationships
  externalMatches ExternalMatch[]
  moviePeople     MoviePerson[]
  movieGenres     MovieGenre[]
  physicalCopies  PhysicalCopy[]
  alternativeTitles AlternativeTitle[]
  images          MediaImage[]   @relation("MovieImages")
  boxSetItems     BoxSetItem[]

  @@index([title])
  @@index([year])
  @@index([sourceType])
  @@index([status])
  @@index([upc])
  @@index([asin])
}

// External platform matches (TMDB, IMDB, etc.)
model ExternalMatch {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  movieId     String
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  source      ExternalSource
  externalId  String
  url         String?

  // Cached data from external source
  title       String?
  originalTitle String?
  year        Int?
  runtime     Int?
  plot        String?   @db.Text
  tagline     String?
  language    String?
  country     String?

  // Media
  posterUrl   String?
  backdropUrl String?

  // Ratings
  rating      Float?
  voteCount   Int?

  // Release info
  releaseDate DateTime?

  // Full JSON cache of source data
  cachedData  Json?     @db.JsonB

  @@unique([movieId, source])
  @@index([externalId, source])
  @@index([externalId])
}

// People (actors, directors, etc.)
model Person {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  birthDate   DateTime?
  deathDate   DateTime?
  biography   String?   @db.Text
  photoUrl    String?

  // External IDs
  tmdbId      Int?      @unique
  imdbId      String?   @unique

  moviePeople MoviePerson[]

  @@index([name])
}

// Junction table for Movie <-> Person with role
model MoviePerson {
  id          String   @id @default(cuid())

  movieId     String
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  role        PersonRole
  character   String?  // For actors
  job         String?  // For crew (cinematographer, sound designer, etc.)
  order       Int?     // For ordering (e.g., billing order)

  @@unique([movieId, personId, role, character])
  @@index([movieId])
  @@index([personId])
}

// Genres
model Genre {
  id          String   @id @default(cuid())
  name        String   @unique
  tmdbId      Int?     @unique

  movieGenres MovieGenre[]
}

// Junction table for Movie <-> Genre
model MovieGenre {
  id          String   @id @default(cuid())

  movieId     String
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  genreId     String
  genre       Genre    @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([movieId, genreId])
  @@index([movieId])
  @@index([genreId])
}

// Physical media copies (DVD, Blu-ray, etc.)
model PhysicalCopy {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movieId     String
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  // Format details
  format      PhysicalFormat
  isSuper     Boolean? // For film formats: Super 8, Super 16, etc.
  editionName String?  // Full human-readable edition name, e.g. "Blood Feast VHS (Something Weird Video 1971)"
  packageType String?  // Standard VHS Case, Slipcase, Digipak, etc.
  language    String?  // Language(s) of this release, e.g. "French", "Bilingual FR/EN"
  region      String?  // DVD region, Blu-ray region, etc.
  videoStandard String? // NTSC, PAL, SECAM
  country     String?  // Release country, e.g. "US", "UK"
  edition     String?  // Collector's Edition, Director's Cut, etc.
  discCount   Int?     // Number of discs/tapes in the set
  components  Json?    // { packageTypes: [], includedItems: [], colors: [] }

  // Audio & Video details
  audioFormats String[] @default([]) // THX, DTS, Dolby Atmos, etc.
  subtitles    String[] @default([]) // Subtitle languages
  copyProtected Boolean? // Copy protection flag

  // Content details
  bonusContent String? @db.Text // Description of special/bonus disc content
  studio       String? // Studio/Production company
  editionPublisher String? // Edition publisher (different from distributor)

  // Distribution details
  distributor String?
  releaseDate DateTime?
  upc         String?  // Universal Product Code / Barcode
  ean         String?  // European Article Number
  asin        String?  // Amazon Standard Identification Number

  // Condition and ownership (deprecated - moved to CineShelf)
  condition   String?  // New, Like New, Good, Fair, etc.
  location    String?  // Where it's stored
  purchaseDate DateTime?
  purchasePrice Float?
  coverImageUrl String?  // URL to cover image
  notes       String?  @db.Text

  // Box set linkage (when this release is part of a multi-movie box set)
  isBoxSet      Boolean? @default(false)
  boxSetId      String?
  boxSet        BoxSet?  @relation("BoxSetReleases", fields: [boxSetId], references: [id], onDelete: Cascade)
  boxSetPosition Int?    // Position of this movie in the box set

  // Box set specific features (inherited from parent box set)
  hasSlipcover    Boolean? @default(false)
  hasBooklet      Boolean? @default(false)
  hasBonusDisc    Boolean? @default(false)
  bonusDiscCount  Int?
  hasDigitalCopy  Boolean? @default(false)
  has3d           Boolean? @default(false)
  discNumber      Int?     // Disc number within the box set
  discLabel       String?  // Disc label within the box set

  // Submission tracking
  status        EntryStatus @default(PENDING)
  submittedById String?
  submittedBy   User?    @relation("SubmittedPhysicalCopies", fields: [submittedById], references: [id])
  verifiedAt    DateTime?
  rejectedAt    DateTime?
  rejectionReason String? @db.Text

  images          MediaImage[]   @relation("PhysicalCopyImages")
  boxSetItems     BoxSetItem[]

  @@index([movieId])
  @@index([format])
  @@index([boxSetId])
  @@index([upc])
  @@index([ean])
  @@index([asin])
  @@index([status])
}

// Alternative titles for movies
model AlternativeTitle {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  movieId     String
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  title       String
  region      String?  // Region/country code where this title is used (ISO 3166-1)
  type        String?  // Working title, Alternative title, etc.
  source      ExternalSource?

  @@index([movieId])
  @@index([title])
}

// Media images uploaded by users (cover snaps, alternate posters, etc.)
model MediaImage {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  movieId        String?
  movie          Movie?        @relation("MovieImages", fields: [movieId], references: [id], onDelete: Cascade)

  physicalCopyId String?
  physicalCopy   PhysicalCopy? @relation("PhysicalCopyImages", fields: [physicalCopyId], references: [id], onDelete: Cascade)

  imageType   ImageType @default(SNAPSHOT)
  altText     String?

  // Binary stored as base64 data URL (e.g. "data:image/jpeg;base64,...")
  dataUrl     String    @db.Text
  mimeType    String    @default("image/jpeg")
  sizeBytes   Int?
  width       Int?
  height      Int?

  isPrimary   Boolean   @default(false)

  uploadedById String?
  uploadedBy   User?    @relation("UploadedImages", fields: [uploadedById], references: [id])

  @@index([movieId])
  @@index([physicalCopyId])
  @@index([uploadedById])
}

// Site-wide settings (key-value)
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Enums
enum ImageType {
  POSTER
  BACKDROP
  COVER_PHOTO
  SNAPSHOT
}

enum UserRole {
  USER
  ADMIN
}

enum EntryStatus {
  PENDING    // Awaiting admin verification
  VERIFIED   // Publicly visible
  REJECTED   // Rejected by admin
}

enum SourceType {
  MANUAL      // Entered by user from physical media
  TMDB        // Imported from TMDB
  IMDB        // Imported from IMDB
  OMDB        // Imported from OMDB
  AMAZON      // Imported from Amazon
  HYBRID      // Mixed sources
}

enum ExternalSource {
  TMDB
  IMDB
  OMDB
  AMAZON
  MUSICBRAINZ  // For music/CDs
  DISCOGS      // For vinyls/music
  UMDB         // Self-reference for UMDB-exclusive entries
}

enum PersonRole {
  DIRECTOR
  ACTOR
  WRITER
  PRODUCER
  CINEMATOGRAPHER
  EDITOR
  COMPOSER
  CREW          // General crew (camera, sound, art, etc.)
  ARTIST        // For music
  MUSICIAN      // For music
  BAND_MEMBER   // For music
}

enum MediaType {
  MOVIE         // Films, movies
  TV_SHOW       // TV series, episodes
  MUSIC_ALBUM   // Music albums (CDs, digital)
  VINYL         // Vinyl records
  CD            // Audio CDs
  BOOK          // Books (future)
  GAME          // Video games (future)
  OTHER         // Other media types
}

enum PhysicalFormat {
  DVD
  BLU_RAY
  BLU_RAY_4K
  VHS
  LASERDISC
  BETAMAX
  HD_DVD
  DIGITAL
  STREAMING
  CD
  VINYL
  CASSETTE
  EIGHT_TRACK
  MINI_DISC
  FILM_8MM
  FILM_16MM
  FILM_35MM
  FILM_70MM
  OTHER
}

// Box sets (multi-movie collections like "The Matrix Trilogy")
model BoxSet {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  format      String?  // "DVD Box Set", "Blu-ray Box Set", etc.
  edition     String?  // "Ultimate Collection", "Limited Edition"
  region      String?
  packageType String?
  notes       String?  @db.Text

  // Box set specific features
  hasSlipcover    Boolean @default(false)
  hasBooklet      Boolean @default(false)
  hasBonusDisc    Boolean @default(false)
  bonusDiscCount  Int?
  hasDigitalCopy  Boolean @default(false)
  has3d           Boolean @default(false)

  // Media
  coverImageUrl   String?
  spineImageUrl   String?

  // Relationships
  items       BoxSetItem[]
  releases    PhysicalCopy[] @relation("BoxSetReleases")
  components  BoxSetComponent[]

  // Submission tracking
  status        EntryStatus @default(PENDING)
  submittedById String?
  submittedBy   User?    @relation("SubmittedBoxSets", fields: [submittedById], references: [id])
  verifiedAt    DateTime?
  rejectedAt    DateTime?
  rejectionReason String? @db.Text

  @@index([name])
  @@index([status])
}

// Junction table linking box sets to movies/releases
model BoxSetItem {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  boxSetId    String
  boxSet      BoxSet   @relation(fields: [boxSetId], references: [id], onDelete: Cascade)

  // Can link to either a movie OR a specific physical copy
  movieId     String?
  movie       Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)

  physicalCopyId String?
  physicalCopy   PhysicalCopy? @relation(fields: [physicalCopyId], references: [id], onDelete: SetNull)

  // Disc metadata
  discNumber  Int?
  discLabel   String?
  isPresent   Boolean @default(true)
  position    Int     // Order in the box set (0-indexed)

  @@index([boxSetId])
  @@index([movieId])
  @@index([physicalCopyId])
  @@index([position])
}

// Components for box sets (for checklist feature)
model BoxSetComponent {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  boxSetId    String
  boxSet      BoxSet   @relation(fields: [boxSetId], references: [id], onDelete: Cascade)

  // Component details
  type        String   // disc, booklet, insert, slipcover, poster, art_cards, digital_code, case, outer_case, stickers, other
  name        String   // Display name (e.g. "Bonus Disc 1", "Criterion Booklet")
  required    Boolean  @default(true)
  count       Int?     // Optional count for multiple identical components
  position    Int      @default(0) // Display order

  // Source tracking
  isAutoGenerated Boolean @default(false) // True if generated from flags, false if manually added

  @@index([boxSetId])
  @@index([type])
}

// Partner Apps (CineShelf, etc.)
model PartnerApp {
  id          String   @id // e.g., "cineshelf"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  tagline     String?
  description String?  @db.Text
  iconUrl     String?
  installUrl  String?
  openUrl     String?
  platforms   String[] @default([]) // ["iOS PWA", "Android PWA", "Desktop Web"]
  price       String   @default("Free")
  features    String[] @default([]) // Array of feature strings
  promoVideoUrl String?
  integrationNotes String? @db.Text
  isUmdbIntegrated Boolean @default(false)
  isFeatured  Boolean  @default(false)
  status      AppStatus @default(ACTIVE)
  sortOrder   Int      @default(0)

  screenshots PartnerAppScreenshot[]

  @@index([status])
  @@index([isFeatured])
  @@index([sortOrder])
}

// Screenshots for partner apps
model PartnerAppScreenshot {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  appId       String
  app         PartnerApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  url         String
  caption     String?
  sortOrder   Int      @default(0)

  @@index([appId])
  @@index([sortOrder])
}

enum AppStatus {
  ACTIVE
  COMING_SOON
  DEPRECATED
}
